# systemd EnvironmentFile —— 只放运行期需要的环境变量。

# 不带 /usr/local/ssdplus/bin：我们不想让 shell 找到同名启动器造成递归
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 代码目录是只读的（ProtectSystem=strict），禁止 Python 往里写 __pycache__
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PYTHONIOENCODING=UTF-8

# 数据与配置：物理位置 /Volume<N>/@apps/ssdplus/，升级重装都不会动它
SSDPLUS_DATA=/usr/local/ssdplus/data
SSDPLUS_LOG=/usr/local/ssdplus/logs

# 平台代理（TOSDaemon）以 root 身份连 socket，按规范给 0660 即可
SSDPLUS_SOCK_MODE=0660

TZ=Asia/Shanghai
