#!/bin/bash
# SSD助手 —— 卸载后执行
#
# ⚠️ 关于用户数据：
# TOS 的「卸载重装 / 修复安装」会走 dpkg --purge 路径（dpkg.log 里表现为
# `configure ssdplus <ver> <none>`，即把它当成一次全新安装）。所以这里
# **绝对不能删 data 目录**，否则用户从应用中心重装一次，全部采样历史就没了。
#
# 清空数据只能由用户自己在应用里「应用设置 → 清除历史数据」来做，
# 那是带二次确认的操作，不留这种"顺手删库"的口子。
set -e

APPID="ssdplus"
APP="/usr/local/${APPID}"
UNIT_DST="/etc/systemd/system/${APPID}.service"

# 先摘掉 systemd 的注册，否则以后同名的旧 unit 会一直挂在列表里
rm -f "${UNIT_DST}"

# 只清应用自己生成、可重建的运行时产物：
#   webui/   每次装/升级都会从 webui.bz2 重新解压
#   socket   进程退出后残留的
#   /usr/www 平台用于发静态页的软链
rm -rf "${APP}/webui"
rm -f /var/api/"${APPID}".sock
if [ -L "/usr/www/${APPID}" ]; then
    rm -f "/usr/www/${APPID}"
fi

# 即使收到 purge 也不删用户数据与用户账号：
# 账号删了下次安装会换 UID，data 目录的属主就对不上，等于换个方式把数据锁死。
systemctl daemon-reload 2>/dev/null || true

exit 0
